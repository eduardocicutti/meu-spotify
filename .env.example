# Meu Spotify - Variáveis de Ambiente
# Copie para .env e preencha os valores

# ==========================================
# APP
# ==========================================
ENVIRONMENT=development
# Gere com: openssl rand -base64 32
SECRET_KEY=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ==========================================
# SPOTIFY (Developer Dashboard)
# ==========================================
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# IMPORTANTE: Use 127.0.0.1 (não localhost) - requisito da API desde fev/2026
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Scopes para V1 (leitura apenas)
SPOTIFY_SCOPES=user-read-private user-read-email user-library-read playlist-read-private playlist-read-collaborative

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/meuSpotify

# ==========================================
# REDIS (Cache + Sessões)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# FRONTEND (CORS)
# ==========================================
FRONTEND_URL=http://127.0.0.1:5173

# ==========================================
# CACHE TTLs (segundos) - Opcionais
# ==========================================
CACHE_TTL_USER_PROFILE=3600
CACHE_TTL_PLAYLISTS=300
CACHE_TTL_PLAYLIST_TRACKS=600
CACHE_TTL_LIBRARY_STATS=900
CACHE_TTL_ARTIST_GENRES=86400

# ==========================================
# SPOTIFY RATE LIMIT (req/s) - Opcional
# ==========================================
SPOTIFY_RATE_LIMIT=5.0